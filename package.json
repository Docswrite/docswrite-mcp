{
  "name": "@docswrite/docswrite-mcp",
  "version": "0.3.0",
  "description": "MCP server for Docswrite: publish Google Docs to WordPress from Claude, Cursor and other AI assistants",
  "author": "Dvir Atias",
  "homepage": "https://docswrite.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docswrite/docswrite-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Docswrite/docswrite-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "docswrite-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "docswrite",
    "wordpress",
    "google docs",
    "google docs to wordpress"
  ]
}
